    1: def normalize_text(text: str) -> str:
603991:     replacements = {
31789:         "\r": "\n",
31789:         "\xa0": " ",
31789:         "\u3000": " ",
31789:         "（": "(",
31789:         "）": ")",
31789:         "{": "(",
31789:         "}": ")",
31789:         "【": "[",
31789:         "】": "]",
31789:         "［": "[",
31789:         "］": "]",
31789:         "〔": "[",
31789:         "〕": "]",
31789:         "〖": "[",
31789:         "〗": "]",
31789:         "｛": "{",
31789:         "｝": "}",
31789:         "，": ",",
31789:         "：": ":",
31789:         "；": ";",
           }
667569:     for old, new in replacements.items():
635780:         text = text.replace(old, new)
31789:     return re.sub(r"\s+", " ", html.unescape(text)).strip()
       
       
    1: def normalize_digit_text(text: str) -> str:
28720:     return text.translate(str.maketrans("０１２３４５６７８９", "0123456789"))
       
       
