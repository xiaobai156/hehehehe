    1: import re
       
    1: from bs4 import BeautifulSoup
       
    1: from he_app.domain.errors import DedicatedCandidateConflict
    1: from he_app.domain.models import Candidate
    1: from he_app.domain.policies import normalize_digit_text, normalize_pick, normalize_text
    1: from he_app.validation.direction import directional_window
       
       
    1: KAIJIANGFACAI_SITE_ID = "s131_kjfc_234432"
    2: KAIJIANGFACAI_TITLE_RE = re.compile(
    1:     r"^开奖发财\s*\[\s*综合杀料\s*\]\s*11447\.COM$",
    1:     re.I,
       )
    1: KAIJIANGFACAI_HEADERS = ("期数", "杀尾", "杀肖", "杀合", "杀波", "开奖")
    1: TableBlock = list[tuple[int, Candidate]]
       
       
    1: def _deduplicate_blocks(blocks: list[TableBlock]) -> list[TableBlock]:
>>>>>>     unique: list[TableBlock] = []
>>>>>>     signatures: set[tuple[tuple[int, str], ...]] = set()
>>>>>>     for block in blocks:
>>>>>>         signature = tuple((period, candidate.values) for period, candidate in block)
>>>>>>         if not signature or signature in signatures:
>>>>>>             continue
>>>>>>         signatures.add(signature)
>>>>>>         unique.append(block)
>>>>>>     return unique
       
       
    1: def _table_blocks(documents: list[str]) -> list[TableBlock]:
>>>>>>     blocks: list[TableBlock] = []
>>>>>>     for document in documents:
>>>>>>         soup = BeautifulSoup(document, "html.parser")
>>>>>>         tag_order = {id(tag): order for order, tag in enumerate(soup.find_all(True))}
>>>>>>         for title in soup.select(".list-title"):
>>>>>>             title_text = normalize_text(title.get_text(" ", strip=True))
>>>>>>             if KAIJIANGFACAI_TITLE_RE.fullmatch(title_text) is None:
>>>>>>                 continue
       
>>>>>>             table = title.find_next("table")
>>>>>>             next_title = title.find_next(class_="list-title")
>>>>>>             if table is None or (
>>>>>>                 next_title is not None and tag_order[id(next_title)] < tag_order[id(table)]
                   ):
>>>>>>                 continue
       
>>>>>>             header = table.find("tr")
>>>>>>             if header is None:
>>>>>>                 continue
>>>>>>             headers = tuple(
>>>>>>                 normalize_text(cell.get_text(" ", strip=True))
>>>>>>                 for cell in header.find_all(["th", "td"], recursive=False)
                   )
>>>>>>             if headers != KAIJIANGFACAI_HEADERS:
>>>>>>                 continue
       
>>>>>>             block: TableBlock = []
>>>>>>             for row in table.find_all("tr"):
>>>>>>                 cells = [
>>>>>>                     normalize_digit_text(normalize_text(cell.get_text(" ", strip=True)))
>>>>>>                     for cell in row.find_all(["th", "td"], recursive=False)
                       ]
>>>>>>                 if len(cells) != len(KAIJIANGFACAI_HEADERS):
>>>>>>                     continue
>>>>>>                 period_match = re.fullmatch(r"(\d{1,4})\s*期", cells[0])
>>>>>>                 value_match = re.fullmatch(r"(0?[1-9]|1[0-3])", cells[3])
>>>>>>                 if period_match is None or value_match is None:
>>>>>>                     continue
>>>>>>                 row_period = int(period_match.group(1))
>>>>>>                 value = f"{int(value_match.group(1)):02d}合"
>>>>>>                 block.append(
>>>>>>                     (
>>>>>>                         row_period,
>>>>>>                         Candidate(
>>>>>>                             values=value,
>>>>>>                             line=normalize_text(
>>>>>>                                 f"{row_period}期:开奖发财 综合杀料 杀合[{value}] "
>>>>>>                                 + " | ".join(cells)
                                   ),
>>>>>>                             score=120,
>>>>>>                             order=len(block),
                               ),
                           )
                       )
>>>>>>             if block:
>>>>>>                 blocks.append(block)
       
>>>>>>     unique = _deduplicate_blocks(blocks)
>>>>>>     if len(unique) > 1:
>>>>>>         candidates = [candidate for block in unique for _period, candidate in block]
>>>>>>         raise DedicatedCandidateConflict(
>>>>>>             sorted({candidate.values for candidate in candidates}),
>>>>>>             [candidate.line for candidate in candidates],
               )
>>>>>>     return unique
       
       
    5: def find_kaijiangfacai_kill_sum_candidate_with_direction(
    4:     documents: list[str], period: int, pick: str = "bottom"
    1: ) -> tuple[Candidate | None, bool]:
>>>>>>     blocks = _table_blocks(documents)
>>>>>>     target_found = any(
>>>>>>         row_period == period for block in blocks for row_period, _candidate in block
           )
>>>>>>     if not blocks:
>>>>>>         return None, target_found
>>>>>>     selected = directional_window(blocks[0], normalize_pick(pick), 1)
>>>>>>     match = next(
>>>>>>         (
>>>>>>             candidate
>>>>>>             for row_period, candidate in selected
>>>>>>             if row_period == period
               ),
>>>>>>         None,
           )
>>>>>>     return match, target_found and match is None
       
       
    3: def extract_kaijiangfacai_kill_sum_period_values(
    1:     documents: list[str],
    1: ) -> dict[int, str]:
>>>>>>     values: dict[int, str] = {}
>>>>>>     for block in _table_blocks(documents):
>>>>>>         for period, candidate in block:
>>>>>>             existing = values.get(period)
>>>>>>             if existing is not None and existing != candidate.values:
>>>>>>                 raise DedicatedCandidateConflict(
>>>>>>                     sorted({existing, candidate.values}),
>>>>>>                     [candidate.line],
                       )
>>>>>>             values[period] = candidate.values
>>>>>>     return values
