    1: def test_cache_layer_writes_current_value_on_conflict(tmp_path: Path) -> None:
    1:     target = tmp_path / "recent.json"
    1:     test_site = site("audit")
    2:     target.write_text(
    2:         json.dumps(
    1:             {
    1:                 "base_period": 211,
    1:                 "periods": 10,
    1:                 "sites": [
    1:                     {
    1:                         "id": "audit",
    1:                         "name": test_site.name,
    1:                         "url": test_site.url,
    1:                         "pick": "top",
    1:                         "browser": False,
    1:                         "click_first": False,
    1:                         "fingerprint": {"211": "03合"},
                           }
                       ],
    1:                 "errors": [],
                   },
    1:             ensure_ascii=False,
               ),
    1:         encoding="utf-8",
           )
    2:     update_recent_cache_from_outcomes(
    1:         target,
    1:         [test_site],
    1:         {0: (test_site, "04合 测试站", "211期 绝杀一合 [04合] 开", None, ["04合"], None)},
    1:         211,
           )
    1:     payload = json.loads(target.read_text(encoding="utf-8"))
    1:     assert payload["sites"][0]["fingerprint"]["211"] == "04合"
    1:     assert payload["errors"] == []
       
       
