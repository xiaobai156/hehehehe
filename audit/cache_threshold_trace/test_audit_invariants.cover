    1: def test_report_and_cache_transaction_rolls_back(tmp_path: Path, monkeypatch: pytest.MonkeyPatch) -> None:
    1:     first = tmp_path / "success.txt"
    1:     second = tmp_path / "cache.json"
    1:     first.write_text("old success", encoding="utf-8")
    1:     second.write_text("old cache", encoding="utf-8")
    1:     original_replace = Path.replace
    1:     raised = False
       
    1:     def fail_second_once(path: Path, target: Path):
               nonlocal raised
    3:         if Path(target) == second and not raised:
    1:             raised = True
    1:             raise PermissionError("simulated cache failure")
    2:         return original_replace(path, target)
       
    1:     monkeypatch.setattr(Path, "replace", fail_second_once)
    2:     with pytest.raises(PermissionError):
    2:         commit_text_transaction_unlocked(
    1:             {first: ("new success", "utf-8"), second: ("new cache", "utf-8")}
               )
    1:     assert first.read_text(encoding="utf-8") == "old success"
    1:     assert second.read_text(encoding="utf-8") == "old cache"
       
       
