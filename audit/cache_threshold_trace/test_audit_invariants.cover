    1: def test_runner_cli_defaults_and_future_exception_fallback() -> None:
    1:     args = runner.build_arg_parser().parse_args([])
    1:     test_site = site("audit")
       
    2:     class FailedFuture:
    1:         def result(self):
    1:             raise RuntimeError("boom")
       
    1:     fallback = runner.consume_site_future(FailedFuture(), test_site, 7)
       
    1:     assert args.workers == 8
    1:     assert fallback[:3] == (7, test_site, None)
    1:     assert fallback[4] == "RuntimeError: boom"
