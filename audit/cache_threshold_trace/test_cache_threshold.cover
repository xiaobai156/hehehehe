    1:         encoding="utf-8",
           )
       
       
    1: def test_cache_update_threshold_is_strictly_more_than_85_percent() -> None:
    1:     assert cache_update_allowed(0, 0) is False
    1:     assert cache_update_allowed(85, 100) is False
    1:     assert cache_update_allowed(86, 100) is True
    1:     assert cache_update_allowed(17, 20) is False
    1:     assert cache_update_allowed(18, 20) is True
       
       
    1: def test_runner_skips_success_fingerprint_update_but_marks_failures_at_or_below_threshold(
           tmp_path: Path, monkeypatch
       ) -> None:
    1:     sites = [_site(1), _site(2)]
