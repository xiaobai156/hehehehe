    1: def _args(tmp_path: Path, cache_path: Path, success_path: Path, fail_path: Path) -> SimpleNamespace:
    4:     return SimpleNamespace(
    2:         period=211,
    2:         success=str(success_path),
    2:         fail=str(fail_path),
    2:         timeout=1,
    2:         workers=1,
    2:         retries=0,
    2:         delay=0.0,
