    1: def test_runner_updates_cache_and_marks_failed_sites_above_threshold(tmp_path: Path, monkeypatch) -> None:
    9:     sites = [_site(index) for index in range(1, 8)]
    1:     cache_path = tmp_path / "recent.json"
    1:     success_path = tmp_path / "success.txt"
    1:     fail_path = tmp_path / "fail.txt"
    2:     monkeypatch.setattr(runner, "load_sites", lambda _path: sites)
       
    1:     def scrape(index, current_site, *_args, **_kwargs):
    7:         if index == 0:
    1:             return index, current_site, None, "211期抓取失败", None, [], "请求失败"
    6:         value = f"{index:02d}合"
    6:         return index, current_site, f"{value} {current_site.name}", f"211期 [绝杀一合] [{value}] 开", None, [value], None
       
    1:     monkeypatch.setattr(runner, "scrape_parallel_site", scrape)
    1:     args = _args(tmp_path, cache_path, success_path, fail_path)
       
    1:     assert runner.run(args) == 0
       
    1:     payload = json.loads(cache_path.read_text(encoding="utf-8"))
    1:     assert payload["base_period"] == 211
    1:     assert len(payload["sites"]) == 6
    8:     assert all(item["fingerprint"] == {"211": f"{index:02d}合"} for index, item in enumerate(payload["sites"], 1))
    1:     assert payload["errors"][0]["id"] == "threshold-1"
    1:     assert payload["errors"][0]["status"] == "失败"
    1:     assert payload["errors"][0]["period"] == 211
