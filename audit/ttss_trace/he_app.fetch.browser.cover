    1:     def get_documents(self, url: str, period: int, click_first: bool, timeout: int) -> list[str]:
>>>>>>         if self.driver is None:
>>>>>>             raise RuntimeError("Browser is not started")
>>>>>>         self.driver.set_page_load_timeout(timeout)
>>>>>>         try:
>>>>>>             self.driver.get(url)
