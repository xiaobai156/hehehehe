   29:     comps = {}
   29:     mapping = bytearray(256)
   29:     block = 0
   29:     data = bytearray()
 7453:     for i in range(0, 65536, 256):
 7424:         chunk = charmap[i: i + 256]
 7424:         if chunk in comps:
 7279:             mapping[i // 256] = comps[chunk]
               else:
  145:             mapping[i // 256] = comps[chunk] = block
  145:             block += 1
  145:             data += chunk
   29:     data = _mk_bitmap(data)
   29:     data[0:0] = [block] + _bytes_to_codes(mapping)
   29:     out.append((BIGCHARSET, data))
   29:     out += tail
   29:     return out, hascased
       
