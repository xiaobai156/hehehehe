   42:     comps = {}
   42:     mapping = bytearray(256)
   42:     block = 0
   42:     data = bytearray()
10794:     for i in range(0, 65536, 256):
10752:         chunk = charmap[i: i + 256]
10752:         if chunk in comps:
10554:             mapping[i // 256] = comps[chunk]
               else:
  198:             mapping[i // 256] = comps[chunk] = block
  198:             block += 1
  198:             data += chunk
