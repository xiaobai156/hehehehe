>>>>>>                 session.config.pluginmanager.getplugin('terminalreporter').write(f'\nERROR: {message}\n', red=True, bold=True)
                       # make sure we get the EXIT_TESTSFAILED exit code
>>>>>>                 session.testsfailed += 1
       
>>>>>>         return result
       
