    1: """pytest-cov: avoid already-imported warning: PYTEST_DONT_REWRITE."""
       
    1: __version__ = '7.1.0'
       
    1: import pytest
       
       
    2: class CoverageError(Exception):
    1:     """Indicates that our coverage is too low"""
       
       
    2: class PytestCovWarning(pytest.PytestWarning):
    1:     """
           The base for all pytest-cov warnings, never raised directly.
           """
       
       
    2: class CovDisabledWarning(PytestCovWarning):
    1:     """
           Indicates that Coverage was manually disabled.
           """
       
       
    2: class CovReportWarning(PytestCovWarning):
    1:     """
           Indicates that we failed to generate a report.
           """
       
       
    2: class CentralCovContextWarning(PytestCovWarning):
    1:     """
           Indicates that dynamic_context was set to test_function instead of using the builtin --cov-context.
           """
       
       
    2: class DistCovError(Exception):
    1:     """
           Raised when dynamic_context is set to test_function and xdist is also used.
       
           See: https://github.com/pytest-dev/pytest-cov/issues/604
           """
