 2003:         "〗": "]",
 2003:         "｛": "{",
 2003:         "｝": "}",
 2003:         "，": ",",
 2003:         "：": ":",
 2003:         "；": ";",
           }
42063:     for old, new in replacements.items():
40060:         text = text.replace(old, new)
 2003:     return re.sub(r"\s+", " ", html.unescape(text)).strip()
       
       
    1: def normalize_digit_text(text: str) -> str:
 1610:     return text.translate(str.maketrans("０１２３４５６７８９", "0123456789"))
       
       
