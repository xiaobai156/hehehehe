    1: def normalize_text(text: str) -> str:
38057:     replacements = {
 2003:         "\r": "\n",
 2003:         "\xa0": " ",
 2003:         "\u3000": " ",
 2003:         "（": "(",
 2003:         "）": ")",
 2003:         "{": "(",
 2003:         "}": ")",
 2003:         "【": "[",
 2003:         "】": "]",
 2003:         "［": "[",
 2003:         "］": "]",
 2003:         "〔": "[",
 2003:         "〕": "]",
