    1: import json
    1: import re
    1: import time
    1: from pathlib import Path
       
    1: from he_app.domain.models import Site
    1: from he_app.storage.atomic_write import exclusive_path_lock, write_text_atomic_unlocked
    1: from he_app.storage.reports import extract_current_values_from_success
    1: from he_app.validation.period import is_valid_sum_value
       
       
    1: Outcome = tuple[Site, str | None, str, str | None, list[str], str | None]
       
       
    1: def normalize_site_name(name: str) -> str:
    1:     return re.sub(r"\s+", " ", name).strip()
       
       
    1: def cache_site_key(site: Site) -> str:
>>>>>>     return site.site_id or normalize_site_name(site.name)
       
       
    1: def cache_entry_is_fresh(entry: dict, max_age_hours: float) -> bool:
>>>>>>     if max_age_hours <= 0:
>>>>>>         return True
>>>>>>     updated_at = entry.get("updated_at")
>>>>>>     if not isinstance(updated_at, str) or not updated_at:
>>>>>>         return False
>>>>>>     try:
>>>>>>         updated_time = time.mktime(time.strptime(updated_at, "%Y-%m-%d %H:%M:%S"))
>>>>>>     except ValueError:
>>>>>>         return False
>>>>>>     return (time.time() - updated_time) <= max_age_hours * 3600
       
       
    1: def parse_success_line(line: str) -> tuple[str, str] | None:
>>>>>>     match = re.match(r"^((?:0[1-9]|1[0-3])合)\s+(.+?)\s*$", line.strip())
>>>>>>     if match is None or not is_valid_sum_value(match.group(1)):
>>>>>>         return None
>>>>>>     return match.group(1), match.group(2)
       
       
    1: def load_success_cache(path: Path) -> dict:
>>>>>>     if not path.exists():
>>>>>>         return {"periods": {}}
>>>>>>     try:
>>>>>>         data = json.loads(path.read_text(encoding="utf-8-sig"))
>>>>>>     except (OSError, json.JSONDecodeError):
>>>>>>         return {"periods": {}}
>>>>>>     if not isinstance(data, dict):
>>>>>>         return {"periods": {}}
>>>>>>     if not isinstance(data.get("periods"), dict):
>>>>>>         data["periods"] = {}
>>>>>>     return data
       
       
    1: def cache_entries_for_period(cache: dict, period: int) -> dict[str, dict]:
>>>>>>     periods = cache.setdefault("periods", {})
>>>>>>     entries = periods.setdefault(str(period), {})
>>>>>>     if not isinstance(entries, dict):
>>>>>>         periods[str(period)] = {}
>>>>>>     return periods[str(period)]
       
       
    1: def load_cached_success_by_name(path: Path, period: int, max_age_hours: float) -> dict[str, str]:
>>>>>>     entries = cache_entries_for_period(load_success_cache(path), period)
>>>>>>     cached: dict[str, str] = {}
>>>>>>     for name, entry in entries.items():
>>>>>>         if not isinstance(entry, dict) or not cache_entry_is_fresh(entry, max_age_hours):
>>>>>>             continue
>>>>>>         result = entry.get("result")
>>>>>>         if isinstance(result, str) and parse_success_line(result):
>>>>>>             cached[normalize_site_name(name)] = result
>>>>>>             entry_name = entry.get("name")
>>>>>>             if isinstance(entry_name, str) and entry_name:
>>>>>>                 cached[normalize_site_name(entry_name)] = result
>>>>>>     return cached
       
       
    1: def load_cached_url_by_site(path: Path, period: int, sites: list[Site], max_age_hours: float) -> dict[str, str]:
>>>>>>     entries = cache_entries_for_period(load_success_cache(path), period)
>>>>>>     urls: dict[str, str] = {}
>>>>>>     for site in sites:
>>>>>>         for key in (cache_site_key(site), normalize_site_name(site.name)):
>>>>>>             entry = entries.get(key)
>>>>>>             if not isinstance(entry, dict) or not cache_entry_is_fresh(entry, max_age_hours):
>>>>>>                 continue
>>>>>>             url = entry.get("url")
>>>>>>             if isinstance(url, str) and url and url != site.url:
>>>>>>                 urls[cache_site_key(site)] = url
>>>>>>                 break
>>>>>>     return urls
       
       
    1: def update_success_cache(path: Path, period: int, outcomes: dict[int, Outcome]) -> None:
>>>>>>     with exclusive_path_lock(path):
>>>>>>         cache = load_success_cache(path)
>>>>>>         entries = cache_entries_for_period(cache, period)
>>>>>>         now = time.strftime("%Y-%m-%d %H:%M:%S")
>>>>>>         for _index, (site, result, detail, _error, rank_values, _previous_reason) in outcomes.items():
>>>>>>             parsed = parse_success_line(result or "")
>>>>>>             if parsed is None:
>>>>>>                 continue
>>>>>>             value, name = parsed
>>>>>>             entries[cache_site_key(site)] = {
>>>>>>                 "id": cache_site_key(site),
>>>>>>                 "name": name,
>>>>>>                 "result": result,
>>>>>>                 "value": value,
>>>>>>                 "values": rank_values or [value],
>>>>>>                 "url": site.url,
>>>>>>                 "detail": detail,
>>>>>>                 "updated_at": now,
                   }
>>>>>>         write_text_atomic_unlocked(path, json.dumps(cache, ensure_ascii=False, indent=2) + "\n", "utf-8")
       
       
    1: def save_success_cache_from_lines(path: Path, period: int, success_lines: list[str], sites: list[Site]) -> None:
>>>>>>     with exclusive_path_lock(path):
>>>>>>         cache = load_success_cache(path)
>>>>>>         entries = cache_entries_for_period(cache, period)
>>>>>>         site_by_name = {normalize_site_name(site.name): site for site in sites}
>>>>>>         now = time.strftime("%Y-%m-%d %H:%M:%S")
>>>>>>         next_entries: dict[str, dict] = {}
>>>>>>         for line in success_lines:
>>>>>>             parsed = parse_success_line(line)
>>>>>>             if parsed is None:
>>>>>>                 continue
>>>>>>             value, name = parsed
>>>>>>             site = site_by_name.get(normalize_site_name(name))
>>>>>>             entry_key = cache_site_key(site) if site else normalize_site_name(name)
>>>>>>             existing = entries.get(entry_key, {}) if isinstance(entries.get(entry_key), dict) else {}
>>>>>>             cached_url = existing.get("url") if isinstance(existing.get("url"), str) else ""
>>>>>>             next_entries[entry_key] = {
>>>>>>                 "id": entry_key,
>>>>>>                 "name": name,
>>>>>>                 "result": line,
>>>>>>                 "value": value,
>>>>>>                 "values": extract_current_values_from_success(line),
>>>>>>                 "url": cached_url or (site.url if site else ""),
>>>>>>                 "detail": existing.get("detail", ""),
>>>>>>                 "updated_at": now,
                   }
>>>>>>         cache.setdefault("periods", {})[str(period)] = next_entries
>>>>>>         write_text_atomic_unlocked(path, json.dumps(cache, ensure_ascii=False, indent=2) + "\n", "utf-8")
