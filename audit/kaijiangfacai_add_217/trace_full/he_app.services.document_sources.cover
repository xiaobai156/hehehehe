    2:     if isinstance(payload, list):
>>>>>>         return fklgrq_history_documents_from_json(api_text)
    2:     if not isinstance(payload, dict):
    1:         raise RuntimeError("forum api returned unsupported payload")
    1:     return [f"{payload.get('draw', '')}期:{payload.get('topic', '')}\n{payload.get('content', '')}"]
       
       
    1: def collect_forum_api_documents(session: requests.Session, url: str, timeout: int) -> list[str]:
