    1: import subprocess
    1: from contextlib import nullcontext
    1: from threading import Lock
    1: from urllib.parse import urlparse
       
    1: import requests
       
    1: from he_app.domain.models import Site
       
       
    1: DEFAULT_HEADERS = {
