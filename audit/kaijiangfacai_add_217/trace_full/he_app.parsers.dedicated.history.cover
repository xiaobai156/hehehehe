    1: def hushuobadao_author_blocks(documents: list[str]) -> tuple[list[list[Candidate]], bool]:
>>>>>>     blocks: list[list[Candidate]] = []
>>>>>>     current: list[Candidate] | None = None
>>>>>>     started = False
>>>>>>     found_anchor = False
>>>>>>     order = 0
       
>>>>>>     def finish() -> None:
               nonlocal current, started
>>>>>>         if current:
>>>>>>             blocks.append(current)
>>>>>>         current = None
>>>>>>         started = False
       
>>>>>>     for document in documents:
>>>>>>         lines = [normalize_digit_text(normalize_text(line)) for line in document_text_lines(document)]
>>>>>>         anchor_index = next(
>>>>>>             (index for index, line in enumerate(lines) if re.search(r"胡说八道\s+发表于", line)),
>>>>>>             None,
               )
>>>>>>         if anchor_index is not None:
>>>>>>             if current is not None:
>>>>>>                 finish()
>>>>>>             found_anchor = True
>>>>>>             current = []
>>>>>>             started = False
>>>>>>             lines = lines[anchor_index + 1 :]
>>>>>>         elif current is None:
>>>>>>             continue
>>>>>>         elif any("发表于" in line or re.match(r"^作者\s*[:：]", line) for line in lines):
>>>>>>             finish()
>>>>>>             continue
       
>>>>>>         rows: list[Candidate] = []
>>>>>>         combined = normalize_digit_text(normalize_text(" ".join(lines)))
>>>>>>         for match in HUSHUOBA_DAO_HISTORY_ROW_RE.finditer(combined):
>>>>>>             line = normalize_text(match.group(0))
>>>>>>             rows.append(Candidate(f"{int(match.group(2)):02d}合", line, 120, order))
>>>>>>             order += 1
>>>>>>         if rows:
>>>>>>             current = (current or []) + rows
>>>>>>             started = True
>>>>>>         elif started:
>>>>>>             finish()
       
>>>>>>     if current:
>>>>>>         blocks.append(current)
>>>>>>     return blocks, found_anchor
       
       
    5: def find_hushuobadao_kill_sum_candidate(
    3:     documents: list[str], period: int, pick: str
    1: ) -> tuple[Candidate | None, bool, bool]:
>>>>>>     blocks, found_anchor = hushuobadao_author_blocks(documents)
>>>>>>     if not blocks:
>>>>>>         return None, False, found_anchor
>>>>>>     directional_blocks = directional_window(blocks, pick, 1)
>>>>>>     directional_rows = directional_window(
>>>>>>         [row for block in directional_blocks for row in block], pick, 1
           )
>>>>>>     matches = [
>>>>>>         row
>>>>>>         for row in directional_rows
>>>>>>         if int(HUSHUOBA_DAO_HISTORY_ROW_RE.match(row.line).group(1)) == period
           ]
>>>>>>     all_matches = [
>>>>>>         row
>>>>>>         for block in blocks
>>>>>>         for row in block
>>>>>>         if int(HUSHUOBA_DAO_HISTORY_ROW_RE.match(row.line).group(1)) == period
           ]
>>>>>>     if matches:
>>>>>>         return select_dedicated_candidate(matches, pick), False, True
>>>>>>     return None, bool(all_matches), True
       
       
    1: def extract_hushuobadao_kill_sum_period_values(documents: list[str]) -> dict[int, str]:
>>>>>>     blocks, _found_anchor = hushuobadao_author_blocks(documents)
>>>>>>     values: dict[int, str] = {}
>>>>>>     for block in blocks:
>>>>>>         for row in block:
>>>>>>             period = int(HUSHUOBA_DAO_HISTORY_ROW_RE.match(row.line).group(1))
>>>>>>             existing = values.get(period)
>>>>>>             if existing is not None and existing != row.values:
>>>>>>                 raise DedicatedCandidateConflict([existing, row.values], [row.line])
>>>>>>             values[period] = row.values
>>>>>>     return values
       
       
