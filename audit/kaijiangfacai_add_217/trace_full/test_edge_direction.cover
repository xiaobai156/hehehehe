    1: def site(site_id: str, pick: str) -> Site:
   11:     return Site("测试站", "https://example.test/topic/1.html", pick, False, False, site_id)
       
       
    1: def rows(items: list[tuple[int, int]]) -> str:
  112:     return "\n".join(
   51:         f"{period}期 绝杀一合 [{value:02d}合] 开00准" for period, value in items
           )
       
       
    1: def test_directional_window_uses_physical_edge_not_period_order() -> None:
    1:     items = [("001", "first"), ("365", "middle"), ("214", "last")]
       
    1:     assert directional_window(items, "top", 3) == [items[0]]
    1:     assert directional_window(items, "bottom", 3) == [items[-1]]
       
       
    1: def test_directional_window_rejects_invalid_size_and_handles_empty() -> None:
    2:     with pytest.raises(ValueError, match="方向窗口必须大于0"):
    1:         directional_window([1], "top", 0)
    1:     assert directional_window([], "bottom") == []
       
       
    1: def test_window_helper_api_exposes_only_the_physical_edge() -> None:
    1:     parts = [
    1:         ("214期 绝杀一合 [02合] 开00准", True),
    1:         ("213期 绝杀一合 [01合] 开00准", True),
           ]
       
    1:     assert ordered_candidate_window_parts(parts, "top", size=9) == [parts[0]]
    1:     assert ordered_candidate_window_parts(parts, "bottom", size=9) == [parts[-1]]
    1:     assert ordered_candidate_window_periods(parts, "top") == {214}
    1:     assert candidate_window_lines(parts, "bottom") == {parts[-1][0]}
    1:     assert candidate_window_keys(parts, "top") == {(214, "02合")}
    1:     assert candidate_window_key("只有说明文字") is None
       
       
    1: def test_common_candidate_helpers_preserve_edge_and_diagnostics() -> None:
    1:     document = "作者:测试站\n" + rows([(214, 2), (213, 1)])
       
    1:     assert selected_latest_period_candidate([document], "top").values == "02合"
    1:     assert selected_latest_period_candidate(["无数据"], "top") is None
    1:     assert find_candidate([document], 214, "top").values == "02合"
    1:     assert find_candidate([document], 213, "top") is None
    2:     assert collect_period_lines([document], 214) == [
    1:         "214期 绝杀一合 [02合] 开00准"
           ]
       
    1:     raw_parts = [
               ("214期 绝杀一合 [02合] 开00准", True),
               ("214期 绝杀一合 [06合] 开00准", True),
               ("无效候选", True),
           ]
    1:     values, lines = conflict_values_from_trusted_parts(raw_parts)
    1:     assert values == ["02合", "06合"] and len(lines) == 2
    1:     assert select_candidate_from_trusted_parts(raw_parts, "top").values == "02合"
    1:     assert select_candidate_from_trusted_parts(raw_parts, "bottom").values == "06合"
    1:     assert select_candidate_from_trusted_parts([], "top") is None
       
       
    2: @pytest.mark.parametrize(
    1:     "detail,error,category,stage",
    1:     [
               ("", "TimeoutError: slow", "请求失败", "网络请求"),
               ("未执行", None, "未执行", "任务执行"),
               ("测试站 没找到作者锚点", None, "锚点缺失", "目标定位"),
               ("找到214期但数量校验失败", None, "数据不完整", "数据校验"),
               ("页面里没找到214期", None, "无当期", "指定期数校验"),
           ],
       )
    6: def test_failure_classification_keeps_stage_contract(
    4:     detail: str, error: str | None, category: str, stage: str
    1: ) -> None:
    5:     failure = classify_failure(214, detail, error)
    5:     assert failure.category == category
    5:     assert failure_stage(failure.category) == stage
       
       
    1: @pytest.mark.parametrize("pick,target", [("top", 213), ("bottom", 213)])
    1: def test_generic_direction_requires_target_at_block_edge(pick: str, target: int) -> None:
    2:     document = "作者:测试站\n" + rows([(214, 1), (213, 2), (212, 3)])
       
    2:     result = parse_site_period(site("s001_topic_206535", pick), target, [document])
       
    2:     assert not result.success
    2:     assert result.failure and result.failure.category in {"方向范围外", "超出范围"}
       
       
    1: @pytest.mark.parametrize("pick,target", [("top", 213), ("bottom", 213)])
    1: def test_batch_direction_requires_target_at_block_edge(pick: str, target: int) -> None:
    2:     site_id = "s097_topic_250886"
    2:     assert REGISTRY._parsers[site_id].__name__ == "_parse_batch"
    2:     document = rows([(214, 1), (213, 2), (212, 3)])
       
    2:     result = parse_site_period(site(site_id, pick), target, [document])
       
    2:     assert not result.success
    2:     assert result.failure and result.failure.category in {"方向范围外", "超出范围"}
       
       
    1: def test_table_direction_requires_target_at_block_edge() -> None:
    2:     document = "\n".join(
    1:         [
                   "澳门综合杀 杀合",
                   "214期 [01合] 开00准",
                   "213期 [02合] 开00准",
                   "212期 [03合] 开00准",
               ]
           )
       
    1:     top = parse_site_period(site("s058_vkjwinyt", "top"), 213, [document])
    1:     bottom = parse_site_period(site("s058_vkjwinyt", "bottom"), 213, [document])
       
    1:     assert not top.success
    1:     assert not bottom.success
       
       
    1: def test_generic_top_ignores_later_duplicate_target_outside_edge() -> None:
    2:     document = "作者:测试站\n" + rows(
    1:         [
                   (214, 2),
                   (213, 1),
                   (212, 12),
                   (222, 11),
                   (221, 9),
                   (220, 7),
                   (219, 8),
                   (218, 4),
                   (217, 13),
                   (216, 8),
                   (215, 5),
                   (214, 6),
               ]
           )
       
    1:     result = parse_site_period(site("s003_topic_193293", "top"), 214, [document])
       
    1:     assert result.success and result.value == "02合 测试站"
       
       
    1: def test_batch_uses_only_first_row_when_target_repeats_at_top() -> None:
