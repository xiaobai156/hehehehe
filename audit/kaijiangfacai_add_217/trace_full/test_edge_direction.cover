    1: def test_manager_rows_use_physical_edge_before_same_period_conflict() -> None:
    1:     document = """
           <article data-manager-record-id="6a1f8c61b67e3ff2e4c4ecbb"
                    data-manager-author="以爱之名" data-manager-section="mainarticle">
             <div data-manager-body="1">
               <p>214期:[以爱之名]绝杀一合[02]开:</p>
               <p>213期:[以爱之名]绝杀一合[01]开:</p>
               <p>214期:[以爱之名]绝杀一合[06]开:</p>
             </div>
           </article>
           """
       
    1:     top, top_outside = find_yiaizhimin_kill_sum_candidate([document], 214, "top")
    2:     bottom, bottom_outside = find_yiaizhimin_kill_sum_candidate(
    1:         [document], 214, "bottom"
           )
       
    1:     assert top and top.values == "02合" and not top_outside
    1:     assert bottom and bottom.values == "06合" and not bottom_outside
       
       
    1: def test_structured_cycles_select_only_the_direction_edge_cycle() -> None:
    1:     document = """
           <div class="title">214期:[绝杀一合]甲作者</div>
           <div class="topic-author">作者:甲作者</div>
           <div class="topic-content">
             <p>214期:绝杀一合[杀02合]开:00准</p>
             <p>213期:绝杀一合[杀01合]开:00准</p>
           </div>
           <div class="title">214期:[绝杀一合]乙作者</div>
           <div class="topic-author">作者:乙作者</div>
           <div class="topic-content">
             <p>214期:绝杀一合[杀06合]开:00准</p>
             <p>213期:绝杀一合[杀05合]开:00准</p>
           </div>
           """
       
    1:     top, top_outside = find_dajiafa_kill_sum_candidate([document], 214, "top")
    2:     bottom, bottom_outside = find_dajiafa_kill_sum_candidate(
    1:         [document], 213, "bottom"
           )
       
    1:     assert top and top.values == "02合" and not top_outside
    1:     assert bottom and bottom.values == "05合" and not bottom_outside
       
       
    1: def test_generic_bottom_ignores_earlier_duplicate_target_outside_edge() -> None:
    2:     document = "作者:测试站\n" + rows(
    1:         [(214, 6), (211, 3), (212, 4), (213, 5), (214, 2)]
           )
       
    1:     result = parse_site_period(site("s003_topic_193293", "bottom"), 214, [document])
       
    1:     assert result.success and result.value == "02合 测试站"
       
       
    1: def test_direction_outside_source_cannot_conflict_with_qualified_edge() -> None:
    2:     body = SourceDocument(
    1:         "作者:测试站\n" + rows([(214, 2), (213, 1), (212, 12)]),
    1:         fetch_kind="browser",
    1:         document_type="body-text",
    1:         authority_id="browser:body",
    1:         document_id="browser:body",
           )
    2:     old_source = SourceDocument(
    1:         "作者:测试站\n" + rows([(222, 11), (221, 9), (220, 7), (214, 6)]),
    1:         fetch_kind="browser",
    1:         document_type="page-source",
    1:         authority_id="browser:source",
    1:         document_id="browser:source",
           )
       
    2:     result = parse_site_period(
    1:         site("s003_topic_193293", "top"), 214, [body, old_source]
           )
       
    1:     assert result.success and result.value == "02合 测试站"
