    2: class AFDPollFlags(enum.IntFlag):
           # These are drawn from a combination of:
           #   https://github.com/piscisaureus/wepoll/blob/master/src/afd.h
           #   https://github.com/reactos/reactos/blob/master/sdk/include/reactos/drivers/afd/shared.h
    1:     AFD_POLL_RECEIVE = 0x0001
    1:     AFD_POLL_RECEIVE_EXPEDITED = 0x0002  # OOB/urgent data
    1:     AFD_POLL_SEND = 0x0004
    1:     AFD_POLL_DISCONNECT = 0x0008  # received EOF (FIN)
    1:     AFD_POLL_ABORT = 0x0010  # received RST
    1:     AFD_POLL_LOCAL_CLOSE = 0x0020  # local socket object closed
    1:     AFD_POLL_CONNECT = 0x0040  # socket is successfully connected
    1:     AFD_POLL_ACCEPT = 0x0080  # you can call accept on this socket
    1:     AFD_POLL_CONNECT_FAIL = 0x0100  # connect() terminated unsuccessfully
           # See WSAEventSelect docs for more details on these four:
    1:     AFD_POLL_QOS = 0x0200
    1:     AFD_POLL_GROUP_QOS = 0x0400
    1:     AFD_POLL_ROUTING_INTERFACE_CHANGE = 0x0800
    1:     AFD_POLL_EVENT_ADDRESS_LIST_CHANGE = 0x1000
       
       
