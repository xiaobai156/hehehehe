    1: def normalize_text(text: str) -> str:
791806:     replacements = {
41674:         "\r": "\n",
41674:         "\xa0": " ",
41674:         "\u3000": " ",
41674:         "（": "(",
41674:         "）": ")",
41674:         "{": "(",
41674:         "}": ")",
41674:         "【": "[",
41674:         "】": "]",
41674:         "［": "[",
41674:         "］": "]",
41674:         "〔": "[",
41674:         "〕": "]",
41674:         "〖": "[",
41674:         "〗": "]",
41674:         "｛": "{",
41674:         "｝": "}",
41674:         "，": ",",
41674:         "：": ":",
41674:         "；": ";",
           }
875154:     for old, new in replacements.items():
833480:         text = text.replace(old, new)
41674:     return re.sub(r"\s+", " ", html.unescape(text)).strip()
       
       
    1: def normalize_digit_text(text: str) -> str:
35825:     return text.translate(str.maketrans("０１２３４５６７８９", "0123456789"))
       
       
